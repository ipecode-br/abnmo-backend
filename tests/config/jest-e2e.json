{
  "preset": "ts-jest",
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/e2e/**/*.e2e-spec.ts"],
  "maxWorkers": 1,
  "setupFilesAfterEnv": ["<rootDir>/config/setup-e2e.ts"],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^uuid$": "<rootDir>/../src/__mocks__/uuid.ts"
  },
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "isolatedModules": true,
          "allowJs": true,
          "skipLibCheck": true
        },
        "transpileOnly": true
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!@faker-js).+"
  ],
  "testTimeout": 30000,
  "forceExit": true,
  "clearMocks": true,
  "restoreMocks": true
}
