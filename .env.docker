# Environment
NODE_ENV=development
APP_ENVIRONMENT=docker
ENABLE_NEST_LOGS=false
MAINTENANCE=false

# API
API_BASE_URL=http://localhost
API_PORT=3333

# APPs
APP_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
DASHBOARD_KEY=dashboard-key

# Secrets
COOKIE_DOMAIN=localhost
COOKIE_SECRET=super-secret-here
JWT_SECRET=super-secret-here
HASH_PEPPER=super-pepper-here

# Database
DB_HOST=database
DB_PORT=5432
DB_DATABASE=abnmo_dev
DB_USERNAME=abnmo_user
DB_PASSWORD=abnmo_password

# Observability
SENTRY_DSN=
SENTRY_LOGS=none

# Storage
STORAGE_ENABLED=false
STORAGE_BUCKET_NAME=bucket-name
CDN_URL=http://cdn-localhost
CDN_PUBLIC_KEY_ID=cdn-public-key-id
CDN_PRIVATE_KEY=cdn-private-key

# Signature
SIGNATURE_ENABLED=false
SIGNATURE_MODEL_KEY=XXX
CLICKSIGN_API_URL=http://localhost
CLICKSIGN_API_KEY=clicksign-api-key
CLICKSIGN_WEBHOOK_SECRET=clicksign-webhook-secret

# Queues
EMAIL_QUEUE_URL=http://localhost:4566/000000000000/email-queue
WHATSAPP_QUEUE_URL=http://localhost:4566/000000000000/whatsapp-queue

# Workers

# E-mails
EMAIL_PROVIDER=none
RESEND_KEY=resend-key
SQS_EMAIL_MAX_RECEIVE_COUNT=5

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID="phone-number-id-01234567890123456789012345678901"
WHATSAPP_META_API_VERSION="v23.0"
SQS_WHATSAPP_MAX_RECEIVE_COUNT=5
