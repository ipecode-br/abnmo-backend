{
  "name": "abnmo-svm-backend",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run db:migrate && nest start --watch",
    "lint:eslint:check": "eslint .",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write . --log-level=warn",
    "validate": "prettier --check . && eslint . && tsc --noEmit",
    "services:up": "docker compose -f infra/docker/compose-dev.yaml --env-file .env up -d",
    "services:stop": "docker compose -f infra/docker/compose-dev.yaml --env-file .env stop",
    "services:down": "docker compose -f infra/docker/compose-dev.yaml --env-file .env down",
    "services:wait:database": "ts-node ./infra/scripts/wait-for-database.ts",
    "db:generate": "ts-node ./infra/scripts/generate-migration.ts",
    "db:migrate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./infra/database/data.source.ts migration:run",
    "db:seed-dev": "ts-node -r tsconfig-paths/register infra/scripts/seed-dev/index.ts",
    "test": "npm run test:prepare && npm run test:unit && npm run test:e2e",
    "test:prepare": "docker compose -f infra/docker/compose-dev.yaml --env-file .env up -d && NODE_ENV=test npm run services:wait:database && NODE_ENV=test ts-node infra/scripts/create-test-schema.ts && NODE_ENV=test npm run db:migrate",
    "test:reset": "NODE_ENV=test ts-node infra/scripts/drop-test-schema.ts && NODE_ENV=test npm run test:prepare",
    "test:unit": "jest --config ./tests/config/jest-unit.json",
    "test:unit:watch": "jest --config ./tests/config/jest-unit.json --watch",
    "test:e2e": "NODE_ENV=test jest --config ./tests/config/jest-e2e.json --runInBand",
    "test:e2e:watch": "NODE_ENV=test jest --config ./tests/config/jest-e2e.json --runInBand --watch",
    "build:lambda": "ts-node infra/scripts/build-lambda.ts",
    "build:docker": "tsc -p tsconfig.docker.json && tsc-alias -p tsconfig.docker.json",
    "docker:dev:up": "docker compose -f infra/docker/dev/compose.yaml --env-file .env.docker up -d",
    "docker:dev:stop": "docker compose -f infra/docker/dev/compose.yaml --env-file .env.docker stop",
    "docker:dev:down": "docker compose -f infra/docker/dev/compose.yaml --env-file .env.docker down",
    "docker:dev:rebuild": "docker compose -f infra/docker/dev/compose.yaml --env-file .env.docker down -v && docker compose -f infra/docker/dev/compose.yaml --env-file .env.docker up -d --build",
    "docker:dev:logs": "docker compose -f infra/docker/dev/compose.yaml --env-file .env.docker logs -f api",
    "docker:dev:clean": "docker compose -f infra/docker/dev/compose.yaml --env-file .env.docker down -v && docker volume prune -f --filter \"label=com.docker.compose.project=svm_dev\" && docker rmi svm-dev-api",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "3.1047.0",
    "@aws-sdk/client-s3": "3.1053.0",
    "@aws-sdk/client-ses": "3.1047.0",
    "@aws-sdk/cloudfront-signer": "3.1052.0",
    "@aws-sdk/s3-presigned-post": "3.1078.0",
    "@nestjs/class-validator": "0.13.1",
    "@nestjs/common": "11.1.21",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.21",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/mapped-types": "2.1.0",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/typeorm": "11.0.1",
    "@sentry/nestjs": "10.68.0",
    "@types/aws-serverless-express": "3.3.10",
    "@vendia/serverless-express": "4.12.6",
    "archiver": "7.0.1",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "date-fns": "4.1.0",
    "nestjs-pino": "4.4.0",
    "nestjs-zod": "5.4.0",
    "pg": "8.22.0",
    "pino-http": "10.5.0",
    "pino-pretty": "13.0.0",
    "reflect-metadata": "0.2.2",
    "resend": "6.17.2",
    "rxjs": "7.8.1",
    "typeorm": "1.0.0",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.18.0",
    "@faker-js/faker": "10.5.0",
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.0.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.10.7",
    "@types/archiver": "6.0.3",
    "@types/aws-lambda": "8.10.149",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "29.5.14",
    "@types/multer": "2.1.0",
    "@types/node": "22.10.7",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.2",
    "dotenv": "16.4.7",
    "esbuild": "0.25.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.2",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "fs-extra": "11.3.0",
    "globals": "15.14.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-mock-extended": "4.0.1",
    "lint-staged": "16.0.0",
    "prettier": "3.4.2",
    "source-map-support": "0.5.21",
    "supertest": "7.1.0",
    "ts-jest": "29.3.1",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.16",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0"
  }
}
